Use o código com cuidado.Step 3: Write the Production Pipeline ScriptBecause vLLM uses an OpenAI-compatible API layout, you can leverage the official openai SDK, redirecting the base_url to your private SLM server port 8000.Save the following code as trends_engine_worker.py:pythonimport json
import random
import requests
from bs4 import BeautifulSoup
from openai import OpenAI
from pydantic import BaseModel, Field
from typing import List

# 1. Connect to your private self-hosted SLM server
SLM_SERVER_URL = "http://localhost:8000/v1" 
client = OpenAI(base_url=SLM_SERVER_URL, api_key="not-needed-for-local")

# 2. Define strict schema output constraints
class DesignTemplateSchema(BaseModel):
    theme_name: str = Field(description="Catchy name for the design theme")
    industry_niche: str = Field(description="The specific target industry sector")
    visual_vibe: str = Field(description="The aesthetic mood or style tone")
    primary_hex: str = Field(description="Dominant UI color hex code")
    accent_hex: str = Field(description="UI accent call-to-action color hex code")
    typography_stack: List[str] = Field(description="Exactly two matching fonts: [Heading Font, Body Font]")
    layout_wireframe_notes: str = Field(description="Structural description of component layouts")

# 3. Dynamic trend ingestion engine
def fetch_live_web_signals():
    try:
        res = requests.get("https://awwwards.com", headers={"User-Agent": "Mozilla"}, timeout=5)
        soup = BeautifulSoup(res.text, 'html.parser')
        return [t.text.strip() for t in soup.find_all('div', class_='tag')[:10]]
    except Exception:
        return ["Minimalism", "Bento Grid Layout", "3D Interactive Element", "Dark Mode UI"]

# 4. Core matrix parameters
INDUSTRIES = ["DeFi Platforms", "Precision Agritech", "Longevity Clinics", "E-Mobility Logistics", "Virtual Real Estate"]
BASE_LAYOUTS = ["Split-Screen Hero", "Bento Grid Dashboard", "Minimalist Editorial Carousel", "Immersive Canvas"]

# 5. Generation orchestration block
def generate_and_parse_theme():
    live_signals = fetch_live_web_signals()
    
    # Combinatorial selection logic
    industry = random.choice(INDUSTRIES)
    layout = random.choice(BASE_LAYOUTS)
    trend_signal = random.choice(live_signals)
    
    prompt = f"Design a cutting-edge web theme blueprint. Industry: {industry}. Base Structure: 
{layout}. Aesthetic Signal: {trend_signal}."

    # Use OpenAIs structured output endpoint syntax, native to vLLM
    response = client.beta.chat.completions.parse(
        model="meta-llama/Meta-Llama-3-8B-Instruct",
        messages=[
            {"role": "system", "content": "You are a professional web UI/UX design generator system. 
Your job is to output design specifications strictly formatted to the requested JSON schema structural
constraints."},
            {"role": "user", "content": prompt}
        ],
        response_format=DesignTemplateSchema, # Enforces schema at the server sampler level
        temperature=0.7
    )
    
    # Return structured Python dictionary validation object
    return response.choices[0].message.parsed.model_dump()

if __name__ == "__main__":
    print("Executing batch generation task against SLM Server...")
    try:
        new_theme = generate_and_parse_theme()
        print(json.dumps(new_theme, indent=4))
    except Exception as e:
        print(f"Server Worker Error: {e}")
