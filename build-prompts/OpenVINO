Use o código com cuidado.Step 3: Write the OpenVINO GenAI Code with Token-Level JSON ConstraintsThis production-ready Python script handles the local web scraping, defines a rigid Pydantic data contract, and forces OpenVINO to execute the inference on either your NUK’s integrated GPU (GPU) or NPU (NPU).pythonimport json
import random
import requests
from bs4 import BeautifulSoup
from pydantic import BaseModel, Field
from typing import List
import openvino_genai as ov_genai

# 1. Define your data contract via Pydantic
class NUKThemeSchema(BaseModel):
    theme_name: str = Field(description="Catchy name for the design theme")
    colors: List[str] = Field(description="Exactly three HEX codes: Primary, Secondary, Accent")
    fonts: List[str] = Field(description="Two font family names: [Heading, Body]")
    layout_concept: str = Field(description="One clear sentence layout outline")

# 2. Extract Web Signals
def fetch_live_signals():
    try:
        res = requests.get("https://awwwards.com", headers={"User-Agent": "Mozilla"}, timeout=3)
        soup = BeautifulSoup(res.text, 'html.parser')
        return [t.text.strip() for t in soup.find_all('div', class_='tag')[:5]]
    except:
        return ["Minimalism", "Bento Grid Layout", "Dark Neo-Brutalism"]

# 3. Trends Combinatorial Parameters
INDUSTRIES = ["SaaS Fintech", "GreenTech Logistics", "AI BioHacking", "Luxury Craft Coffee"]

def run_openvino_engine():
    signals = fetch_live_signals()
    industry = random.choice(INDUSTRIES)
    trend = random.choice(signals)
    
    # Constructing a lean prompt
    prompt = f"System: You are an elite web architect. Create a design schema for a {industry} site utilizing {trend} concepts.\nUser: Generate the specifications."

    # 4. Initialize the OpenVINO LLM Pipeline
    # Options for Meteor Lake: 'GPU' (Recommended for pure speed) or 'NPU' (Ultra-low power consumption)
    model_path = "./llama3-ov-int4"
    pipe = ov_genai.LLMPipeline(model_path, "GPU") 

    # 5. Extract JSON Schema from Pydantic and create generation constraints
    json_schema_str = json.dumps(NUKThemeSchema.model_json_schema())
    
    config = ov_genai.GenerationConfig()
    config.max_new_tokens = 256
    config.temperature = 0.6
    
    # Magic step: Tell OpenVINO to enforce token-level JSON rules
    config.response_format = {"type": "json_object", "schema": json_schema_str}

    print(f"Compiling and running inference on Intel Arc GPU...")
    response = pipe.generate(prompt, config)
    
    # 6. Safely validate the output
    validated = NUKThemeSchema.model_validate_json(response)
    return validated.model_dump()

if __name__ == "__main__":
    theme_data = run_openvino_engine()
    print("\n--- SUCCESSFULLY GENERATED VIA INTEL OPENVINO ---")
    print(json.dumps(theme_data, indent=4))

