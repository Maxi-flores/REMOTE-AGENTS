const fs = require('fs');
const path = require('path');
const { exec, execSync } = require('child_process');

const RUNTIME_ROOT = process.cwd();
const QUEUE_DIR = path.join(RUNTIME_ROOT, '.platform_queue');
const TASK_FILE = path.join(QUEUE_DIR, 'next_task.json');
const LOCK_FILE = path.join(QUEUE_DIR, 'processing.lock');
const FAILED_DIR = path.join(QUEUE_DIR, 'failed');

// Ensure all basic architectural storage primitives exist before listening
[QUEUE_DIR, FAILED_DIR].forEach(dir => fs.mkdirSync(dir, { recursive: true }));

/**
 * Validates the physical file properties of the uploaded asset to ensure it is not corrupt or empty.
 */
function isPngBulletproof(filePath) {
    try {
        if (!fs.existsSync(filePath)) return false;
        const stats = fs.statSync(filePath);
        if (stats.size < 100) return false; // Basic file check: too small to be a real valid PNG

        // Read first 8 magic bytes to ensure it's a structural PNG image asset
        const buffer = Buffer.alloc(8);
        const fd = fs.openSync(filePath, 'r');
        fs.readSync(fd, buffer, 0, 8, 0);
        fs.closeSync(fd);

        const pngMagicNumber = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);
        return buffer.equals(pngMagicNumber);
    } catch (e) {
        console.error(`[🚨 Security/Validation Error]: Image block evaluation failed: ${e.message}`);
        return false;
    }
}

/**
 * Central router execution pass
 */
function triggerPythonProcessingLoop() {
    // Prevent execution collisions if another instance is already crunching data
    if (fs.existsSync(LOCK_FILE)) {
        console.log("[-] Lock file active. Ingestion system is busy.");
        return;
    }

    try {
        if (!fs.existsSync(TASK_FILE)) return;

        // Secure processing lock immediately
        fs.writeFileSync(LOCK_FILE, JSON.stringify({ pid: process.pid, timestamp: Date.now() }));
        console.log("[🤖 Router]: processing.lock established. Parsing payload schema...");

        const rawData = fs.readFileSync(TASK_FILE, 'utf8');
        const task = JSON.parse(rawData);

        // Enforce structural protocol schema alignment
        if (task.action !== "AUTOMATIC_UPLOAD_DIR_GENERATION" || !task.payload) {
            throw new Error("Invalid action payload signature protocol rejected.");
        }

        const sourceImgPath = path.join(RUNTIME_ROOT, task.payload.source_image);
        
        // Debounce delay to prevent processing files that are currently uploading/streaming in over slow networks
        let checks = 0;
        while (checks < 5) {
            if (isPngBulletproof(sourceImgPath)) break;
            console.log(`[🔄 Debounce Wait]: Target file is missing or still compiling. Retrying check... (${checks + 1}/5)`);
            execSync('sleep 2');
            checks++;
        }

        if (checks === 5) {
            throw new Error(`Asset at '${sourceImgPath}' failed safety validation tests (corrupt or unreadable).`);
        }

        console.log("[🚀 Ingestion Passed]: Invoking authoritative Python pipeline module...");
        
        // Execute the native python script pass
        exec(`python3 src/orchestrator/upload_and_push.py`, (err, stdout, stderr) => {
            if (err) {
                console.error(`[❌ Script Execution Crash]: ${stderr}`);
                handleLoopFailure(task);
            } else {
                console.log(`[✅ System Output]: ${stdout}`);
                cleanupExecutionTokens();
            }
        });

    } catch (error) {
        console.error(`[🚨 Ingestion Exception Caught]: ${error.message}`);
        cleanupExecutionTokens();
    }
}

function handleLoopFailure(taskPayload) {
    try {
        const failurePath = path.join(FAILED_DIR, `failed_${Date.now()}_task.json`);
        fs.writeFileSync(failurePath, JSON.stringify(taskPayload, null, 2));
        if (fs.existsSync(TASK_FILE)) fs.unlinkSync(TASK_FILE);
        console.log(`[🛑 Target Fault]: Task moved safely out of queue to fallback tracking storage: ${failurePath}`);
    } catch (e) {
        console.error(`[🚨 Fallback Matrix Broken]: ${e.message}`);
    } finally {
        cleanupExecutionTokens();
    }
}

function cleanupExecutionTokens() {
    if (fs.existsSync(LOCK_FILE)) fs.unlinkSync(LOCK_FILE);
    console.log("[🔄 Sync Status Reset]: Cleaned operational states. Router listener idle.");
}

// Watch the targeted filesystem folder bounds for operational additions
console.log(`[📡 Sentinel Online]: Listening for incoming payloads in ${QUEUE_DIR}...`);
fs.watch(QUEUE_DIR, (eventType, filename) => {
    if (filename === 'next_task.json' && fs.existsSync(TASK_FILE)) {
        // Trigger execution pass with a clean process loop separation
        setTimeout(triggerPythonProcessingLoop, 100);
    }
});
