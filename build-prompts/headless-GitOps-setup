# sync-agent.sh - The Input Daemon

echo "🚀 Sync Agent active. Monitoring GitHub for remote prompts..."

while true; do
  # Fetch latest changes from GitHub without merging yet
  git fetch origin main &> /dev/null
  
  LOCAL=$(git rev-parse HEAD)
  REMOTE=$(git rev-parse @{u})
  
  if [ "$LOCAL" != "$REMOTE" ]; then
    echo "📥 New remote prompt detected! Syncing workspace..."
    git pull origin main
    
    # Check if a prompt.md file exists and has instructions
    if [ -f "prompt.md" ]; then
      echo "🔥 Triggering Action Agent..."
      # Execute Cline CLI or your master orchestrator script
      # This hands off the workspace to the Action Agent loop
      node run-action-agent.js
    fi
  fi
  
  # Wait 30 seconds before polling GitHub again to avoid rate limits
  sleep 30
done
