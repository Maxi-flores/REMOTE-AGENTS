run-action-agent.js
const { execSync } = require('child_process');
const fs = require('fs');

try {
  console.log("🤖 Action Agent: Parsing prompt.md...");
  const userPrompt = fs.readFileSync('prompt.md', 'utf8');

  // Trigger Cline CLI to handle the file modifications and run the self-healing loop
  // Cline will call 'python3 call_codex.py' internally in the terminal when it needs Codex output
  console.log("💻 Invoking Cline Engine...");
  execSync(`cline --instruction "Process the following remote task: ${userPrompt}. Use 
'python3 call_codex.py' to generate code assets. When complete, run local web verification."`, 
{ stdio: 'inherit' });

  // Once Cline finishes without errors, push the finalized code back to your GitHub
  console.log("📤 Self-healing complete. Pushing fixes back to GitHub...");
  execSync('git add .');
  execSync('git commit -m "🤖 Auto-Heal: Resolved all UI/UX issues via remote agent loop"');
  execSync('git push origin main');
  
  // Clear the prompt file so it doesn't trigger repeatedly on the next cycle
  fs.writeFileSync('prompt.md', '# Waiting for next remote instruction...');
  execSync('git add prompt.md && git commit -m "🔄 Reset prompt trigger" && git push origin main');
  console.log("✅ Cycle finished. Sync Agent is listening again.");

} catch (error) {
  console.error("❌ Action Agent Loop Failed:", error.message);
  // Optional: Push the crash logs back to GitHub so you can read them via Chromium
  fs.writeFileSync('crash_log.txt', error.stack);
  execSync('git add crash_log.txt && git commit -m "🚨 Agent Crash Log" && git push origin main');
}
