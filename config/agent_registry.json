{
  "schema_version": 1,
  "description": "Master agent registry for multi-repo governance routing.",
  "default_profile": {
    "primary_agent_class": "RuntimeDiagnosticAgent",
    "twin_agent_class": "RuntimeDiagnosticTwinAgent",
    "execution_constraints": {
      "num_thread": 4,
      "quantization_preference": "Q5_K_M",
      "max_context_chars": 12000
    },
    "compiler_runtime_contract": {
      "raw_source_only": true,
      "forbid_markdown_wrappers": true,
      "forbid_conversational_text": true,
      "skills_guardrail_file": "skills.md",
      "enforce_skills_visual_tokens": true,
      "forbid_inline_style_overrides": true,
      "forbid_hardcoded_style_tokens": true,
      "isolate_component_boundaries_before_repair": true,
      "preserve_responsive_fluid_scaling": true,
      "emit_single_refactored_source_artifact": true
    }
  },
  "groups": {
    "spa_ui_frontends_vite_react": [
      "ConceptSHOP",
      "Powerframe-CRM",
      "TheRocketTree-Web"
    ],
    "full_stack_frameworks_nextjs": [
      "Dealinstinct Frontend",
      "Dealinstinct V2",
      "Bikerinstinct",
      "WOMmedia"
    ],
    "monorepos_and_hubs": [
      "Powerframe",
      "PowerStarter",
      "TheRocketTree-App"
    ],
    "data_pipelines_and_workers": [
      "Powerframe-GMS",
      "Powerframe-TPR",
      "Powerframe-WMS",
      "Trade Agent – V1"
    ],
    "three_d_and_game_tools": [
      "Sapient KB",
      "Mucho3D",
      "TheRocketTreeUnity"
    ],
    "pending_unmapped_fallbacks": [
    ],
    "ml_and_metadata_pipelines": [
      "PF-WAI"
    ]
  },
  "repositories": {
    "ConceptSHOP": {
      "primary_agent_class": "ViteReactPrimaryAgent",
      "twin_agent_class": "ViteReactTwinAgent",
      "execution_constraints": {
        "num_thread": 4,
        "quantization_preference": "Q5_K_M",
        "max_context_chars": 12000
